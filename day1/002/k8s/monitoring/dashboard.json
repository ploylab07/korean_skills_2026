  "panels": [
    {
      "type": "timeseries",
      "title": "Book App CPU Utilization",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "targets": [{
        "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"wskorea26\",pod=~\"book.*\",container!=\"\",container!=\"POD\"}[5m])) by (pod, container)",
        "legendFormat": "{{pod}}/{{container}} Utilization",
        "refId": "A"
      }],
      "datasource": {"type": "prometheus", "uid": "prometheus"}
    },
    {
      "type": "timeseries",
      "title": "Container Memory Usage",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "targets": [{
        "expr": "sum(container_memory_working_set_bytes{container!=\"\",container!=\"POD\"}) by (pod, container)",
        "legendFormat": "{{pod}}/{{container}}",
        "refId": "A"
      }],
      "datasource": {"type": "prometheus", "uid": "prometheus"}
    },
    {
      "type": "timeseries",
      "title": "Running Pods",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "id": 3,
      "targets": [{
        "expr": "count(kube_pod_status_phase{phase=\"Running\"})",
        "legendFormat": "running",
        "refId": "A"
      }],
      "datasource": {"type": "prometheus", "uid": "prometheus"}
    },
    {
      "type": "timeseries",
      "title": "Container Restarts",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "id": 4,
      "targets": [{
        "expr": "sum(kube_pod_container_status_restarts_total) by (pod, container)",
        "legendFormat": "{{pod}}/{{container}}",
        "refId": "A"
      }],
      "datasource": {"type": "prometheus", "uid": "prometheus"}
    },
    {
      "type": "timeseries",
      "title": "Container Network Receive",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16},
      "id": 5,
      "targets": [{
        "expr": "sum(rate(container_network_receive_bytes_total[5m])) by (pod)",
        "legendFormat": "{{pod}}",
        "refId": "A"
      }],
      "datasource": {"type": "prometheus", "uid": "prometheus"}
    }
  ],
