apiVersion: karpenter.sh/v1
kind: NodePool
metadata:
  name: skm-app-nodepool
spec:
  template:
    metadata:
      labels:
        skm-app: "true"
    spec:
      nodeClassRef:
        group: karpenter.k8s.aws
        kind: EC2NodeClass
        name: skm-app-nodeclass
      taints:
      - key: skm-app
        value: "true"
        effect: NoSchedule
      requirements:
      - key: node.kubernetes.io/instance-type
        operator: In
        values: ["t3.small", "t3.medium"]
      - key: karpenter.sh/capacity-type
        operator: In
        values: ["on-demand"]
      - key: kubernetes.io/arch
        operator: In
        values: ["amd64"]
  disruption:
    consolidationPolicy: WhenEmptyOrUnderutilized
    consolidateAfter: 60s
    budgets:
    - nodes: "100%"
---
apiVersion: karpenter.k8s.aws/v1
kind: EC2NodeClass
metadata:
  name: skm-app-nodeclass
spec:
  role: ${node_role_name}
  amiSelectorTerms:
  - alias: al2023@latest
  subnetSelectorTerms:
  - tags:
      karpenter.sh/discovery: skm-eks-cluster
  securityGroupSelectorTerms:
  - tags:
      karpenter.sh/discovery: skm-eks-cluster
  tags:
    Name: skm-app-node
    karpenter.sh/discovery: skm-eks-cluster
