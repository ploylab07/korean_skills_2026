resource "aws_iam_role_policy" "aws_lb_controller" {
  name = "${local.prefix}-aws-lb-controller-policy"
  role = aws_iam_role.aws_lb_controller.id
  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect   = "Allow"
      Action   = ["iam:CreateServiceLinkedRole"]
      Resource = "*"
      Condition = {
        StringEquals = { "iam:AWSServiceName" = "elasticloadbalancing.amazonaws.com" }
      }
    }, {
      Effect = "Allow"
      Action = ["ec2:*", "elasticloadbalancing:*", "wafv2:*", "shield:*", "acm:DescribeCertificate", "acm:ListCertificates"]
      Resource = "*"
    }]
  })
}

