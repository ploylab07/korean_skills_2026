# AWS credentials — copy to .env and fill in (or run setup-aws)
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_DEFAULT_REGION=ap-northeast-2

# Contest number for day2/002 S3 names (terraform.tfvars is gitignored).
# Do NOT use 001 — globally taken. Example: PARTICIPANT_ID=588
PARTICIPANT_ID=

# --- day3 (works on any AWS account / PC; TF_VAR_* overrides terraform.tfvars) ---
# Required: RDS password (min 8 chars). Do not commit real passwords.
DB_PASSWORD=
# Optional naming (defaults match competition: project=apdev, environment=dev)
# DAY3_PROJECT=apdev
# DAY3_ENVIRONMENT=dev
# DB_IDENTIFIER=apdev-rds-instance
# Or set full wipe prefix: APDEV_PREFIX=apdev-dev
